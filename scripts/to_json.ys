# Lower RTL, reduce state to positive-edge registers, and map combinational
# logic to the Minecraft target gate set before writing JSON.

read_verilog -sv @VERILOG_FILE@
hierarchy -check@TOP_MODULE_DIRECTIVE@
proc; opt; fsm; opt; memory; opt
techmap; opt
dffunmap
dfflegalize -cell $_DFF_P_ x
abc -g NAND,OR
clean
json -o @OUTPUT_JSON@
